# PlusDelivery — variabile de mediu pentru PRODUCTIE.
# Copiaza acest fisier in `.env`, completeaza valorile reale si NU-l comite in git.
#   cp .env.example .env  &&  nano .env
# Stack-ul: docker compose -f docker-compose.prod.yml up -d --build

# --- Django ----------------------------------------------------------------
# Cheie secreta reala (genereaza una noua, de ex.:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())")
DJANGO_SECRET_KEY=schimba-ma-cu-o-cheie-reala-si-lunga

# OBLIGATORIU 0 in productie (activeaza intarirea de securitate din settings.py).
DJANGO_DEBUG=0

# Domeniile permise, separate prin virgula (fara schema, fara /).
ALLOWED_HOSTS=domeniu.exemplu.ro,www.domeniu.exemplu.ro

# Originile de incredere pentru CSRF (CU schema https://).
CSRF_TRUSTED_ORIGINS=https://domeniu.exemplu.ro

# Domeniul rutat de Traefik catre aceasta aplicatie (folosit in label-urile din
# docker-compose.prod.yml: Host(`${DOMAIN}`)). Fara schema, fara /.
DOMAIN=domeniu.exemplu.ro

# Traefik face deja redirectul HTTP->HTTPS la margine, deci lasam 0 ca sa evitam
# un al doilea redirect la nivel de Django (requesturile ajung deja ca https).
SECURE_SSL_REDIRECT=0

# --- Baza de date (Postgres) ----------------------------------------------
# Aceste trei valori configureaza containerul `db` din docker-compose.prod.yml.
POSTGRES_DB=plusdelivery
POSTGRES_USER=plusdelivery
POSTGRES_PASSWORD=schimba-ma-cu-o-parola-reala

# URL-ul citit de Django (dj-database-url). Host-ul `db` = numele serviciului
# Postgres din compose. Trebuie sa corespunda cu cele trei valori de mai sus.
DATABASE_URL=postgres://plusdelivery:schimba-ma-cu-o-parola-reala@db:5432/plusdelivery

# --- Channels / WebSocket (optional) --------------------------------------
# Lasa necompletat pentru un singur worker Daphne (InMemoryChannelLayer, corect
# pentru designul realtime actual). Seteaza doar daca scalezi pe mai multe
# procese CU un broadcaster dedicat (vezi nota din settings.py).
# REDIS_URL=redis://redis:6379/0

# --- HSTS (optional) -------------------------------------------------------
# Durata HSTS in secunde (implicit 1 an). Seteaza 0 cat timp testezi TLS.
# SECURE_HSTS_SECONDS=31536000
